{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "baseUrl": ".",
    // El motor de i18n de la suite es un paquete ESM con tipos en
    // `Components/i18n.d.ts`: con `moduleResolution: node` no se resuelve, así
    // que se apunta al archivo de tipos. Sin esto, el build del servidor no
    // compila la UI que sí lo importa (`src/ui/batch.ts`).
    "paths": { "@abdsynths/shared/i18n": ["./node_modules/@abdsynths/shared/Components/i18n.d.ts"] },
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  // La UI de navegador usa DOM y se compila aparte (tsconfig.ui.json): sus
  // ficheros no pueden pasar por la configuración del servidor, que no tiene
  // lib DOM. Los que sí son puros (batch, bank-import, recents) se incluyen al
  // importarlos desde `src/client/index.ts`.
  "exclude": ["src/ui/browser", "src/ui/table.ts"]
}
