{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  // La UI de navegador usa DOM y se compila aparte (tsconfig.ui.json): sus
  // ficheros no pueden pasar por la configuración del servidor, que no tiene
  // lib DOM. Los que sí son puros (batch, bank-import, recents) se incluyen al
  // importarlos desde `src/client/index.ts`.
  "exclude": ["src/ui/browser", "src/ui/table.ts"]
}
